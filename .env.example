# --- LLM: DeepSeek Flash via any OpenAI-compatible endpoint ---
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=400
# Only set to false for a private gateway with an expired/self-signed certificate.
LLM_SSL_VERIFY=true

# Legacy aliases still work: OPENAI_API_KEY / OPENAI_API_BASE / DEEPSEEK_API_KEY

# --- product behaviour ---
SPOILER_CONFIDENCE_THRESHOLD=0.7
MAX_COMMENT_CHARS=500
MAX_UPLOAD_MB=20
MAX_PARAGRAPHS=5000
# Public demo: upload a sample book first, then set this to false.
ALLOW_UPLOADS=true

# --- infrastructure ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Load the embedding model from the local cache first; only go online when it
# is missing. Set to false on an air-gapped machine with the model pre-cached.
EMBEDDING_ALLOW_DOWNLOAD=true
DATABASE_URL=sqlite:///./spoiler_shield.db
UPLOAD_DIR=uploads

# --- admin (set a password for any remote or proxied deployment) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- deployment (Docker Compose + Caddy) ---
# DOMAIN=books.example.com
